# Copy to .env and fill in. Never commit .env.

# --- LiteLLM gateway -------------------------------------------------------
LITELLM_MASTER_KEY=sk-interest-local

# --- AWS (the gateway mounts ~/.aws read-only; no keys needed here) ---------
AWS_REGION=us-east-2
AWS_PROFILE=default

# --- MCP tool server -------------------------------------------------------
# Both values come from the agent repo:
#   cd ../interest-calculator-agent/infra/toolhive
#   terraform output -raw mcp_url
#   terraform output -raw mcp_token
MCP_SERVER_URL=
MCP_SERVER_TOKEN=

# --- TLS on an intercepting network (optional) -----------------------------
# Only needed where a ZTNA agent or corporate proxy re-signs TLS. Generate the
# bundle with `source scripts/env.sh`, which writes .certs/combined-ca.pem.
MCP_CA_BUNDLE=

# --- Platform-hosted agent (AICP) ------------------------------------------
# Set these when the agent runs on AICP rather than in your own AWS account.
# Its runtime is locked to a JWT authorizer, so the LiteLLM route above cannot
# reach it -- the platform signs the AgentCore call for you.
#   URL:   the "Agent API" tab on the agent's page
#   TOKEN: a Keycloak access token for your platform account
AICP_AGENT_URL=
AICP_ACCESS_TOKEN=
